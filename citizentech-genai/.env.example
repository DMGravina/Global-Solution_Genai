# ==============================================================================
# Configurações do Assistente Conversacional CitizenTech (Arquitetura RAG)
# ==============================================================================

# Diretório da base de conhecimento rastreável
PASTA_CORPUS=corpus

# Parâmetros do Retriever Híbrido (BM25 Lexical + Vetorial TF-IDF)
TOP_K=3
LIMIAR_CONFIANCA_RETRIEVER=0.22
PESO_BM25=0.45
PESO_VETORIAL=0.55

# Provedor do Generator (LLM)
# Opções disponíveis:
#   "fallback" -> Motor determinístico grounded local (zero custo, roda offline sem chave)
#   "groq"     -> API gratuita Groq Cloud (https://console.groq.com)
#   "ollama"   -> Servidor local Ollama (http://localhost:11434)
LLM_PROVIDER=fallback

# Configurações para Groq (opcional - gratuito)
GROQ_API_KEY=sua_chave_gratuita_groq_aqui
GROQ_MODEL=llama-3.1-8b-instant

# Configurações para Ollama (opcional - local)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2